# Local research archives: never publish these files.
/README.local.md
/chats/
/CDN_IPV6_TEST_PLAN.md
/CDN_IPV6_TEST_RUNBOOK.md
/local/
/private/

# Live inventory, credentials, and generated VPN client/server configurations.
/ansible/inventories/production/
/credentials/
/backups/
/artifacts/
/reports/
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.agekey
age-keys.txt
id_rsa*
id_ed25519*
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.sql
*.dump
*.pcap
*.pcapng
*.log

# secrets/: only README.md and SOPS-encrypted files are tracked (docs/SECRETS.md).
# Everything else is ignored; plaintext, decrypted output, and keys stay ignored
# even when they also match an allowed pattern.
/secrets/**
!/secrets/**/
!/secrets/README.md
!/secrets/**/*.sops.yaml
!/secrets/**/*.sops.yml
/secrets/**/*.plain
/secrets/**/*.plain.*
/secrets/**/*.decrypted
/secrets/**/*.decrypted.*
/secrets/**/*.agekey
/secrets/**/keys.txt
/secrets/**/.encrypt.*/

# Tool environments and build output.
.venv/
__pycache__/
*.py[cod]
.cache/
node_modules/
bin/
dist/
coverage/
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
